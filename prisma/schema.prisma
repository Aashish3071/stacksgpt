datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Channel {
  id            String    @id @default(cuid())
  name          String
  handleOrUrl   String    @unique
  type          String    // "TWITTER", "RSS", "SUBSTACK", "YOUTUBE"
  category      String    @default("General") // "Productivity", "Generative", "Coding", "General"
  isActive      Boolean   @default(true)
  lastFetchedAt DateTime?
  lastSuccessAt DateTime?
  lastError String?
  pollingEnabled Boolean @default(true)
  newsItems     RawNews[]
  createdAt     DateTime  @default(now())
}

model RawNews {
  id          String    @id @default(cuid())
  channelId   String
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  externalUrl String    @unique
  author      String
  title       String?
  rawText     String
  mediaUrl    String?
  // Normalised hash of the title. Catches the same story reported by several
  // outlets, which externalUrl (literal duplicates only) cannot.
  contentHash String?
  // Relevance score from lib/relevance.ts; only the top items are sent to the LLM.
  score       Float     @default(0)
  publishedAt DateTime?
  status      String    @default("PENDING") // "PENDING", "PROCESSED", "IGNORED", "FAILED"
  createdAt   DateTime  @default(now())
  notes String?
  duplicateOf String?
  relevanceScore Float @default(0)
  usefulnessScore Float @default(0)
  noveltyScore Float @default(0)
  article     Article?

  @@index([contentHash])
  @@index([status, score])
}

model ToolAffiliate {
  id            String    @id @default(cuid())
  name          String    @unique
  slug          String    @unique
  tagline       String
  description   String?
  category      String    // "Writing", "Video", "Coding", "Automation", "Research"
  pricingModel  String    @default("Freemium")
  websiteUrl    String    // The tool's real public site. Always present.
  // A real, approved partner link. Null until a deal actually exists — the
  // pipeline must never generate one.
  affiliateUrl  String?
  // "NONE" = plain editorial listing. "ACTIVE" = approved partner link, rendered
  // with rel="sponsored nofollow" and labelled to the reader.
  status        String    @default("NONE")
  // JSON array of alternative names the writer might use, e.g. ["GPT-5","ChatGPT"].
  aliases       String?
  discountCode  String?   // Only ever a code a vendor actually issued you.
  clicksCount   Int       @default(0)
  articles      Article[]
  createdAt     DateTime  @default(now())
}

model Article {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String         // Clear, high-signal headline
  originalTitle   String?
  summary         String         // The 10-second takeaway
  jargonBuster    String         // JSON: [{ technicalTerm, plainEnglish }]
  useCases        String         // JSON: [{ title, targetAudience, stepByStep: [], promptTemplate }]
  verdict         String         // Buying advice / is it worth it?
  category        String         @default("Productivity")
  primaryToolId   String?
  primaryTool     ToolAffiliate? @relation(fields: [primaryToolId], references: [id])
  readingMinutes  Int            @default(3)
  // "DRAFT" | "NEEDS_EDIT" | "PUBLISHED" | "REJECTED".
  // NEEDS_EDIT marks drafts produced by the offline fallback writer, which must
  // never be published without a human rewriting them.
  status          String         @default("DRAFT")
  isPublished     Boolean        @default(false)
  publishedAt     DateTime?
  viewCount       Int            @default(0)
  sourceAuthor    String?
  sourceUrl       String?

  // --- Provenance -------------------------------------------------------
  // "RSS" = drafted by the built-in pipeline. "MDX" = committed to the repo by
  // an external agent and imported by scripts/sync-content.ts.
  origin          String         @default("RSS")
  // Stable id from the MDX filename. Lets the sync step re-import the same file
  // repeatedly without creating duplicates.
  externalId      String?        @unique
  // Hash of the imported file, so unchanged files are skipped on re-sync.
  sourceHash      String?
  // Optional long-form prose from the MDX body, stored as markdown.
  body            String?

  // What kind of story this is: ANNOUNCEMENT | NEWS | UPDATE | TOOL |
  // USE_CASE | SHOWCASE. Drives which sections the article page renders.
  type            String         @default("NEWS")
  // JSON array of bullet points summarising the story, used by reporting pieces.
  keyPoints       String?

  // --- SEO ---------------------------------------------------------------
  // seoTitle is what search engines show; it is length-capped and may differ
  // from the on-page headline. metaDescription is the snippet under it.
  // keywords is a JSON array — note that Google ignores the keywords meta tag,
  // so these exist for internal use and non-Google engines, not for ranking.
  seoTitle        String?
  metaDescription String?
  keywords        String?

  // When the ORIGINAL source published, and when the writing agent fetched it.
  // Distinct from publishedAt, which is when we published our article.
  sourcePublishedAt DateTime?
  retrievedAt       DateTime?

  // --- Imagery ----------------------------------------------------------
  // Path under /public (self-hosted, committed alongside the article) or an
  // absolute URL. Alt text is required alongside it for accessibility and SEO.
  heroImage       String?
  heroImageAlt    String?
  heroImageCredit String?

  searchDocument Unsupported("tsvector")?
  publishedUpdatedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  authorId String?
  reviewedBy String?
  approvedAt DateTime?
  scheduledFor DateTime?
  correctionNote String?
  structuredVerdict Json?
  tags String[] @default([])
  audiences String[] @default([])
  additionalSources Json?
  featured Boolean @default(false)
  editorsPick Boolean @default(false)
  pendingDraft Json?
  pendingHash String?
  pendingStatus String?
  rejectionReason String?
  version Int @default(1)
  heroImageOrigin String @default("generated")
  revisions ArticleRevision[]
  redirects ArticleRedirect[]
  socialPosts SocialPost[]
  rawNewsId       String?        @unique
  rawNews         RawNews?       @relation(fields: [rawNewsId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([searchDocument], type: Gin, map: "Article_search_idx")
  @@index([tags], type: Gin, map: "Article_tags_idx")
  @@index([audiences], type: Gin, map: "Article_audiences_idx")
  @@index([status])
  @@index([category, isPublished])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("homepage")
  confirmedAt DateTime?
  unsubscribedAt DateTime?
  token String @unique @default(uuid())
  createdAt DateTime @default(now())
}

model Profile {
 id String @id
 email String @unique
 displayName String
 role String @default("EDITOR")
 active Boolean @default(true)
 createdAt DateTime @default(now())
}
// A social post is drafted automatically the first time its article is
// published (see transitionArticle in lib/editorial.ts), but never sent
// automatically: an editor must approve it in the newsroom queue first,
// mirroring the article review-queue philosophy. deliverApprovedSocialPosts()
// in lib/social.ts only ever sends rows already APPROVED by a human.
model SocialPost {
  id         String    @id @default(cuid())
  articleId  String
  article    Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  platform   String    // "X" | "LINKEDIN"
  body       String    // editable draft text; length/format differs per platform
  imageUrl   String?   // defaults from the article's heroImage, editable
  status     String    @default("PENDING_APPROVAL") // PENDING_APPROVAL | APPROVED | SENDING | SENT | FAILED | REJECTED
  approvedBy String?
  approvedAt DateTime?
  sentAt     DateTime?
  error      String?
  externalId String?   // tweet id / LinkedIn post URN once sent
  createdAt  DateTime  @default(now())

  @@index([status])
  @@index([articleId])
}
model ArticleRevision {
 id String @id @default(cuid())
 articleId String
 article Article @relation(fields:[articleId],references:[id],onDelete:Cascade)
 version Int
 snapshot Json
 actorId String?
 createdAt DateTime @default(now())
 @@unique([articleId,version])
}
model ArticleRedirect {
 slug String @id
 articleId String
 article Article @relation(fields:[articleId],references:[id],onDelete:Cascade)
}
model AuditLog {
 id String @id @default(cuid())
 actorId String?
 action String
 articleId String?
 detail Json?
 createdAt DateTime @default(now())
 @@index([createdAt])
}
model ImportAttempt {
 id String @id @default(cuid())
 externalId String?
 status String
 errors Json
 createdAt DateTime @default(now())
}
model Taxonomy {
 id String @id @default(cuid())
 kind String
 slug String
 name String
 description String @default("")
 active Boolean @default(true)
 @@unique([kind,slug])
}
model MediaAsset {
 id String @id @default(cuid())
 contentHash String?
 width Int?
 height Int?
 byteSize Int?
 url String @unique
 alt String
 credit String
 origin String
 createdBy String
 createdAt DateTime @default(now())
}
model SiteSetting {
 key String @id
 value Json
}
model Partner {
 id String @id @default(cuid())
 name String
 website String
 disclosure String
 active Boolean @default(false)
 links PartnerLink[]
 createdBy String
 createdAt DateTime @default(now())
}
model PartnerLink {
 id String @id @default(cuid())
 partnerId String
 partner Partner @relation(fields:[partnerId],references:[id])
 label String
 url String
 active Boolean @default(false)
}
model EventDaily {
 id String @id @default(cuid())
 day String
 event String
 articleId String @default("")
 count Int @default(0)
 @@unique([day,event,articleId])
}
model RateLimit {
 key String @id
 count Int @default(1)
 expiresAt DateTime
}
model Newsletter {
 id String @id @default(cuid())
 subject String
 body String
 status String @default("DRAFT")
 createdBy String
 createdAt DateTime @default(now())
 deliveries NewsletterDelivery[]
}
model NewsletterDelivery {
 id String @id @default(cuid())
 newsletterId String
 newsletter Newsletter @relation(fields:[newsletterId],references:[id])
 subscriberId String
 status String @default("PENDING")
 sentAt DateTime?
 error String?
 @@unique([newsletterId,subscriberId])
}
