{
  "name": "ai-updates-web",
  "version": "1.0.0",
  "private": true,
  "browserslist": [
    "defaults and fully supports es6-module",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/sync-content.ts && node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/preflight.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "sync:content": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/sync-content.ts",
    "seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx prisma/seed.ts",
    "preflight": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/preflight.ts",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/bootstrap-admin.ts",
    "test:integration": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx tests/newsroom.integration.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.453.0",
    "marked": "^18.0.12",
    "next": "^15.5.24",
    "nodemailer": "^10.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.5.4",
    "twitter-api-v2": "^1.29.1",
    "yaml": "^2.9.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^8.57.1",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.24",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
