# --- Database ---
# Local dev: file:./dev.db     Production (Neon): postgresql://...?sslmode=require
DATABASE_URL="file:./dev.db"
# Neon only: unpooled connection used by prisma migrate. Leave empty on SQLite.
DIRECT_URL=""

# --- AI writer (OPTIONAL) ---
# Only needed if you want the built-in RSS pipeline to draft articles itself.
# Leave empty when articles are written externally and committed as MDX: the
# ingestion run then collects scored story leads only, and drafts nothing.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# --- Admin panel ---
# Password for /admin login. Use a long random string.
ADMIN_PASSWORD=""
# Secret used to sign the admin session cookie. Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# --- Ingestion cron ---
# Bearer token required by /api/cron/ingest. Generate: openssl rand -hex 32
CRON_SECRET=""

# --- Site ---
# No trailing slash. Drives canonicals, sitemap, feed and OG urls.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Ads ---
# Leave EMPTY until you are approved. Empty = no ad markup renders at all.
# Set to "adsense" to go live (this is also what makes the AdSense application possible).
NEXT_PUBLIC_ADS_PROVIDER=""
NEXT_PUBLIC_ADSENSE_ID=""
