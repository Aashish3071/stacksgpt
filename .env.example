# Server only. Keep actual values in ignored .env.local and Vercel settings.
# Use the Supabase transaction pooler for serverless runtime.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres"
# Use a direct or session-mode connection for migrations.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
# Generate independent random values with at least 32 characters.
INGEST_SECRET=""
CRON_SECRET=""
RATE_LIMIT_SECRET=""
# Public framework variables.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GTM_ID="GTM-T9X6VDM7"
# Comma-separated exact hostnames of approved fallback RSS feeds.
RSS_ALLOWED_HOSTS=""
# Optional newsletter sender. Sending stays disabled until all are configured.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
NEWSLETTER_FROM=""
# Optional social posting. A post is drafted automatically on an article's
# first publish, but stays PENDING_APPROVAL until an editor approves it in
# /admin/social-posts — these vars control sending only, never drafting.
# X (Twitter): create an app at developer.x.com with posting access (write
# access is a paid API tier) and generate OAuth 1.0a user-context credentials.
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_SECRET=""
# LinkedIn: create an app at linkedin.com/developers tied to the target
# Company Page, request the Community Management API product (requires
# LinkedIn's app review), then generate an access token for that app.
# LINKEDIN_ORG_URN looks like "urn:li:organization:12345678".
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_ORG_URN=""
# Explicitly opt in only for the first launch with no approved articles.
ALLOW_EMPTY_BUILD="false"
